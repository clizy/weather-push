        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/apple/Documents/Trae-CN/temp_20261117_01/weather-push</string>

    <key>StandardOutPath</key>
    <string>/Users/apple/Documents/Trae-CN/temp_20261117_01/weather-push/logs/launchd.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/apple/Documents/Trae-CN/temp_20261117_01/weather-push/logs/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
